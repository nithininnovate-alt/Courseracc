# Central Global University — environment variables
# Copy to .env (or configure via systemd/pm2) and fill in real values.
# Values here are examples/placeholders only — never commit real secrets.

# ---------------------------------------------------------------------------
# Core server
# ---------------------------------------------------------------------------
NODE_ENV=production
# Port the API server listens on (nginx proxies to this).
PORT=3001
# Public origin of the deployed app (scheme + host, no trailing slash).
# Used for Bank of Georgia payment callbacks and absolute links in emails.
PUBLIC_BASE_URL=https://your-domain.example.com
# Session/signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Cloud SQL)
# ---------------------------------------------------------------------------
# Standard Postgres connection string. Nothing Replit-specific is required.
DATABASE_URL=postgresql://cgu:password@127.0.0.1:5432/cgu

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# "replit" (Replit App Storage via sidecar — only works on Replit) or
# "gcs" (Google Cloud Storage with a service-account key — works anywhere).
OBJECT_STORAGE_PROVIDER=gcs
# Path to the Google service-account JSON key file (gcs provider only).
# The service account needs the "Storage Object Admin" role on the bucket.
GCS_SERVICE_ACCOUNT_KEY_FILE=/etc/cgu/gcs-service-account.json
# Bucket paths in the form /<bucket-name>/<prefix>:
# Private uploads (student documents, materials, etc.)
PRIVATE_OBJECT_DIR=/your-gcs-bucket/private
# Comma-separated paths searched for publicly served assets (newsletter images)
PUBLIC_OBJECT_SEARCH_PATHS=/your-gcs-bucket/public

# ---------------------------------------------------------------------------
# Authentication (Clerk — student accounts)
# ---------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
# Same publishable key, exposed to the portal build (set at BUILD time).
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# Seed passwords for the built-in staff accounts (created on first boot).
SEED_ADMIN_PASSWORD=
SEED_SUPERADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Payments — Bank of Georgia
# ---------------------------------------------------------------------------
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Email (providers tried in order: SendGrid -> Gmail SMTP -> Resend)
# Configure at least one provider.
# ---------------------------------------------------------------------------
# Sender shown on outgoing mail (must be verified with your provider).
EMAIL_FROM="Central Global University <registrar@your-domain.example.com>"
SENDGRID_API_KEY=
# Gmail SMTP fallback (app password, not the account password).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Resend fallback.
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# AI features (OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
# On Replit these are provided by AI Integrations; elsewhere use your own key.
OPENAI_API_KEY=
# Optional custom base URL for an OpenAI-compatible proxy:
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# AI_INTEGRATIONS_OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Portal build-time variables (used by `vite build`, not by the server)
# ---------------------------------------------------------------------------
# Base path the portal is served from. Use "/" when self-hosting at the root.
BASE_PATH=/
